// ────────────── Output Configuration ──────────────
// Saved from the active display layout configured in wdisplays.
// Positions are in logical pixels (after scaling).
// https://github.com/YaLTeR/niri/wiki/Configuration:-Outputs

// 27D1U: right display, 4K, 200% scaling.
output "DP-1" {
    mode "3840x2160@60.000"
    scale 2
    transform "normal"
    position x=2048 y=288
}

// ARZOPA: left display, 1440p, 125% scaling.
output "HDMI-A-1" {
    mode "2560x1440@59.998"
    scale 1.25
    transform "normal"
    position x=0 y=288
}