@OBSThemeMeta {
    name: 'Morandi';
    id: 'com.obsproject.Yami.Morandi';
    extends: 'com.obsproject.Yami';
    author: 'morandi-gen';
    dark: 'true';
}

@OBSThemeVars {
    --primary: rgb(147,143,122);
    --primary_light: rgb(143,143,126);
    --primary_lighter: rgb(139,142,127);
    --primary_dark: rgb(168,171,160);
    --primary_darker: rgb(26,26,24);

    --blue1: rgb(139,142,127);
    --blue2: rgb(143,143,126);
    --blue3: rgb(147,143,122);
    --blue4: rgb(168,171,160);
    --blue5: rgb(56,55,50);
    --blue6: rgb(48,47,44);

    --bg_base: rgb(18,18,17);
    --bg_window: rgb(26,26,24);
    --bg_preview: rgb(18,18,17);

    --border_color: rgb(56,55,50);

    --input_bg: rgb(48,47,44);
    --input_bg_hover: rgb(56,55,50);
    --input_bg_focus: rgb(56,55,50);

    --list_item_bg_selected: rgb(48,47,44);
    --list_item_bg_hover: rgb(56,55,50);

    --input_border: rgb(64,63,57);
    --input_border_hover: rgb(147,143,122);
    --input_border_focus: rgb(147,143,122);

    --button_bg: rgb(48,47,44);
    --button_bg_hover: rgb(56,55,50);
    --button_bg_down: rgb(64,63,57);
    --button_bg_disabled: rgb(18,18,17);

    --button_bg_red: rgb(178,67,85);
    --button_bg_red_hover: rgb(194,95,99);
    --button_bg_red_down: rgb(178,67,85);

    --button_border: rgb(64,63,57);
    --button_border_hover: rgb(147,143,122);
    --button_border_focus: rgb(147,143,122);

    --tab_bg: rgb(48,47,44);
    --tab_bg_hover: rgb(56,55,50);
    --tab_bg_down: rgb(64,63,57);
    --tab_bg_disabled: rgb(18,18,17);

    --tab_border: rgb(48,47,44);
    --tab_border_hover: rgb(64,63,57);
    --tab_border_focus: rgb(64,63,57);
    --tab_border_selected: rgb(147,143,122);

    --scrollbar_handle: rgb(56,55,50);
    --scrollbar_hover: rgb(64,63,57);
    --scrollbar_down: rgb(48,47,44);
    --scrollbar_border: rgb(56,55,50);

    --toolbutton_bg: rgb(48,47,44);
    --toolbutton_bg_hover: rgb(56,55,50);
    --toolbutton_bg_down: rgb(64,63,57);
    --toolbutton_bg_disabled: rgb(18,18,17);
}
