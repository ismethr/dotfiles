# LanRhyme desktop appearance, adapted for Noctalia v5
[theme]
source = "custom"
custom_palette = "Morandi"
mode = "dark"

[theme.templates]
enable_builtin_templates = false
enable_community_templates = false

[bar.default]
position = "left"
thickness = 34
background_opacity = 0.93
margin_edge = 4
margin_ends = 4
radius = 12
widget_spacing = 6
start = ["launcher", "clock", "cpu", "temp", "ram", "media"]
center = ["workspaces"]
end = ["tray", "notifications", "clipboard", "micyou", "volume", "brightness", "control-center", "session"]

[dock]
enabled = true
auto_hide = true
reserve_space = false
position = "bottom"
active_monitor_only = true
background_opacity = 0.61

[shell]
font_family = "Noto Sans"

[hooks]
started = ["bash ~/.config/noctalia/apply-morandi.sh"]
wallpaper_changed = ["bash ~/.config/noctalia/apply-morandi.sh"]

[accessibility]
ui_scale = 0.9

[plugins]
enabled = ["antigravity/clipboard-osd", "lanrhyme/micyou"]

[widget.ram]
type = "sysmon"
stat = "ram_used"
show_value = false

[widget.micyou]
type = "lanrhyme/micyou:widget"

[wallpaper]
directory = "{{ .chezmoi.homeDir }}/Pictures/WallPapers"
